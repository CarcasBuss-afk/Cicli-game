# Copiare in .env.local (mai versionato). I valori sono gli stessi del progetto
# html-escape-room: Il Giro dei Cicli usa lo stesso progetto Firebase, con collezioni
# proprie (giroSessions/**).

# --- Firebase Admin SDK (solo server) ---
FIREBASE_PROJECT_ID=html-css-attivita
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@html-css-attivita.iam.gserviceaccount.com
# Chiave privata su una riga sola, con "\n" letterali al posto degli a-capo.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Docente ---
# Email autorizzate ad amministrare le gare, separate da virgola.
TEACHER_EMAILS=nome.cognome@scuola.it

# --- Firebase SDK client (pagina docente: login Google e realtime) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=html-css-attivita.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=html-css-attivita
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Il gregario (Cronoscalata) ---
# Chiave Anthropic: stesso valore di edu-code/.env.local. Senza chiave risponde un gregario
# finto (va bene in sviluppo, non in classe).
ANTHROPIC_API_KEY=
# Impostato dai test: forza il gregario finto anche con la chiave.
# GREGARIO_FINTO=1

# --- L'Officina (compiti di realtà con l'account scolastico) ---
# Dominio (o domini, separati da virgola) degli account Google ammessi. Vuoto = tutti.
OFFICINA_DOMINIO=
# Modello del tutor (default claude-sonnet-5-5).
# TUTOR_MODEL=

# --- Opzionali ---
# Richieste al minuto per allievo (default 30).
GIRO_RATE_LIMIT_PER_MINUTE=30
# Impostate dai test, non in sviluppo normale:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8089
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# NEXT_PUBLIC_FIREBASE_EMULATORS=1
